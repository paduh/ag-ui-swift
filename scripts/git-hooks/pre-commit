#!/bin/bash
# Pre-commit hook to prevent direct commits to main branch
# This enforces the feature branch workflow

# Get the current branch name
branch="$(git rev-parse --abbrev-ref HEAD)"

# Check if committing to main
if [ "$branch" = "main" ]; then
    echo "❌ ERROR: Direct commits to 'main' branch are not allowed!"
    echo ""
    echo "Please use the feature branch workflow:"
    echo ""
    echo "  1. Create a feature branch:"
    echo "     git checkout -b feature/your-feature-name"
    echo ""
    echo "  2. Make your commits on the feature branch"
    echo ""
    echo "  3. Push and create a Pull Request:"
    echo "     git push -u origin feature/your-feature-name"
    echo "     gh pr create"
    echo ""
    echo "See CONTRIBUTING.md for more details."
    echo ""
    exit 1
fi

# Allow commits on other branches
exit 0
